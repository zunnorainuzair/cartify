<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- frosted wash of the current cover -->
    <ImageView
        android:id="@+id/playerBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="Backdrop"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_player_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <!-- top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/collapseButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close player"
                android:padding="10dp"
                android:src="@drawable/ic_chevron_down"
                android:tint="@color/text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="PLAYING FROM"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/playerSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="220dp"
                    android:text="Cartify"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!--
                Save the song that is playing, without leaving the player.

                It used to live two levels deep in the overflow, which is the one action a
                stream needs most: the song is right there, sounding correct, and keeping
                it must not cost a menu. Tapping starts the download and does not pause or
                restart playback.
            -->
            <ImageButton
                android:id="@+id/playerDownload"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Download this song"
                android:padding="10dp"
                android:src="@drawable/ic_download"
                android:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/queueButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Queue"
                android:padding="10dp"
                android:src="@drawable/ic_queue"
                android:tint="@color/text_primary" />
        </LinearLayout>

        <Space
            android:id="@+id/topSpace"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- artwork card: square, swipeable, unfolds lyrics on tap -->
        <com.cartify.app.SquareFrameLayout
            android:id="@+id/artCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/artPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="true"
                android:clipToPadding="true" />
        </com.cartify.app.SquareFrameLayout>

        <!-- lyric sheet: same width and corners as the artwork, opening right under it -->
        <FrameLayout
            android:id="@+id/lyricsHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0"
            android:minHeight="0dp">

            <LinearLayout
                android:id="@+id/lyricsPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_lyrics_panel"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:clipToOutline="true"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.1"
                        android:text="LYRICS"
                        android:textColor="@color/accent"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <!-- Escape hatch for a bad match: asks the service again for this song. -->
                    <TextView
                        android:id="@+id/lyricsRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="2dp"
                        android:paddingBottom="4dp"
                        android:text="Wrong lyrics?"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lyricsState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/lyricsListHost"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:visibility="gone">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/lyricsList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:clipToOutline="true"
                        android:paddingTop="10dp"
                        android:paddingEnd="2dp"
                        android:paddingBottom="14dp"
                        android:scrollbars="none"
                        android:visibility="gone" />

                    <!-- Drawn over the list's lower edge so a half-visible row dissolves
                         instead of being cut. Never clickable: it must not eat a tap meant
                         for the lyrics underneath. -->
                    <View
                        android:id="@+id/lyricsFade"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_lyrics_fade"
                        android:clickable="false"
                        android:focusable="false"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <Space
            android:id="@+id/bottomSpace"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- title row with overflow menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/playerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/playerArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/playerMore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="More options"
                android:padding="10dp"
                android:src="@drawable/ic_more"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- seek -->
        <SeekBar
            android:id="@+id/seek"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:paddingStart="0dp"
            android:paddingTop="16dp"
            android:paddingEnd="0dp"
            android:paddingBottom="16dp"
            android:progressDrawable="@drawable/seek_progress"
            android:splitTrack="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timeNow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/timeTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- transport -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/shuffleButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Shuffle"
                android:padding="12dp"
                android:src="@drawable/ic_shuffle"
                android:tint="@color/text_secondary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/prevButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous"
                android:padding="12dp"
                android:src="@drawable/ic_prev"
                android:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_play_large"
                android:contentDescription="Play"
                android:padding="20dp"
                android:src="@drawable/ic_play"
                android:tint="@color/accent_ink" />

            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next"
                android:padding="12dp"
                android:src="@drawable/ic_next"
                android:tint="@color/text_primary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/repeatButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Repeat"
                android:padding="12dp"
                android:src="@drawable/ic_repeat"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- bottom pill, like the reference player -->
        <LinearLayout
            android:id="@+id/playerPill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill_ghost"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Queue"
                android:src="@drawable/ic_music_note"
                android:tint="@color/accent" />

            <TextView
                android:id="@+id/pillText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="All songs in the queue"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/pillQueue"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Open queue"
                android:padding="8dp"
                android:src="@drawable/ic_queue"
                android:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- queue sheet -->
    <LinearLayout
        android:id="@+id/queueSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_deep"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Playing queue"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/queueSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/closeQueue"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Close"
                android:padding="9dp"
                android:src="@drawable/ic_close"
                android:tint="@color/text_primary" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/queueList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="10dp"
            android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>
